local function hopOnce()
    if not httprequest then return false end
    local PlaceId = choosePlaceId()
    local JobId = game.JobId

    local ok, req = pcall(function()
        return httprequest({
            Url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true",
                PlaceId
            )
        })
    end)
    if not ok or not req or not req.Body then
        return false
    end

    local suc, body = pcall(function() return HttpService:JSONDecode(req.Body) end)
    if not suc or not body or not body.data then return false end

    local servers = {}
    for _, server in pairs(body.data) do
        if type(server) == "table" and server.id and server.playing and server.maxPlayers then
            if server.playing < server.maxPlayers and server.id ~= JobId then
                table.insert(servers, server)
            end
        end
    end

    if #servers == 0 then return false end
    local chosen = servers[math.random(1, #servers)]

    pcall(function()
        TPService:TeleportToPlaceInstance(PlaceId, chosen.id, Players.LocalPlayer)
    end)
    return true
end

-- scheduler controller
local hopTask = nil
local function startHopScheduler()
    if hopTask and task.cancel then
        pcall(task.cancel, hopTask)
        hopTask = nil
    end

    if not settings.serverHopToggle then
        return
    end

    hopTask = task.spawn(function()
        while settings.serverHopToggle do
            local delay = tonumber(settings.serverHopDelay) or 15
            if delay < 0.5 then delay = 0.5 end
            task.wait(delay * 60)
            pcall(hopOnce)
            task.wait(math.random(1,3))
        end
    end)
end

local function stopHopScheduler()
    if hopTask and task.cancel then
        pcall(task.cancel, hopTask)
        hopTask = nil
    end
end

function hopSet()
    if settings.serverHopToggle then
        startHopScheduler()
    else
        stopHopScheduler()
    end
end

