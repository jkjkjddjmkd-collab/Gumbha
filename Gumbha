local function formatNumber(n)
    if n == 420 or n == 425 then
        n = n + 10
    end
    if n >= 10000 then
        return string.format("%.1fk", n / 1000)
    elseif n >= 1000 then
        return string.format("%.2fk", n / 1000)
    else
        return tostring(n)
    end
